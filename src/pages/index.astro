---
import Layout from "../layouts/Layout.astro";
import { R2_BASE } from "../lib/r2.js";
---

<Layout title="Jeff's National Parks Photo Gallery">
  <section
    class="hero"
  >
    <div
      class="hero__image"
      style={`background-image: url('${R2_BASE}/hero-main.jpg');`}
    ></div>

    <div class="hero__content">
      <h1 class="hero__title">Jeff's National Parks Photo Gallery</h1>
      <p class="hero__subtitle">
        A collection of moments, landscapes, and memories from the parks I’ve explored.
      </p>

      <a href="/parks" class="button button--primary">
        Explore the Parks
      </a>
    </div>
  </section>
</Layout>
