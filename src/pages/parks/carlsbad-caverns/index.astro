---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/carlsbad-caverns.json";

const park = {
  name: "Carlsbad Caverns National Park",
  location: "New Mexico",
  yearVisited: "2017 & 2022",
  hero: galleryData.hero,
  subtitle: "Vast underground chambers and evening bat flights.",
  description: `Add your description of Carlsbad Caverns here.`.trim(),
  howToGetThere: {
    airport: "El Paso (ELP)",
    notes: "Rent a car — it's about a 2.5 hour drive northeast on US-62.",
  },
  placesToStay: [
    { label: "Add your accommodation here", url: "#" },
  ],
};

const galleryId = "carlsbad-caverns-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
