---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/crater-lake.json";

const park = {
  name: "Crater Lake National Park",
  location: "Oregon",
  yearVisited: 2018,
  hero: galleryData.hero,
  subtitle: "The deepest lake in the US, filling an ancient volcanic caldera.",
  description: `Candace and I visited here in 2018.   We got to the park on the first day and everything was beautiful, the pictures don't do it justice how beautiful that blue water is!! But we only had about an hour look at the lake from the rim.   Unfortunately that night, wild fire smoke moved in and obscured the entire park the next day which was our full day there to spend hiking.  We had just a few hours in the morning of the third day to do some more and we were able to hike down to the lake level on a clear day which was nice.`.trim(),
  howToGetThere: {
    airport: "Portland (PDX)",
    notes: "Rent a car — it's about a 4.5 hour drive south on I-5 and OR-62.",
  },
  placesToStay: [
    { label: "AirBNB near Crater Lake, OR", url: "https://www.airbnb.com/s/Crater-Lake-OR/" },
  ],
};

const galleryId = "crater-lake-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
