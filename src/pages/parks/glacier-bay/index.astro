---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/glacier-bay.json";

const park = {
  name: "Glacier Bay National Park",
  location: "Alaska",
  yearVisited: 2025,
  hero: galleryData.hero,
  subtitle: "Tidewater glaciers and wilderness at the edge of the Pacific.",
  description: `Add your description of Glacier Bay here.`.trim(),
  howToGetThere: {
    airport: "Juneau (JNU)",
    notes: "Fly or take a ferry to Gustavus, then a short drive to the park.",
  },
  placesToStay: [
    { label: "Add your accommodation here", url: "#" },
  ],
};

const galleryId = "glacier-bay-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
