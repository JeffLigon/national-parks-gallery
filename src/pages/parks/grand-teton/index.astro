---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/grand-teton.json";

const park = {
  name: "Grand Teton National Park",
  location: "Wyoming",
  yearVisited: 2014,
  hero: galleryData.hero,
  subtitle: "Jagged peaks rising sharply from the valley floor.",
  description: `We combined our trip here with the Yellowtone trip.  We spent a day here
   doing a tour of Jenny Lake.`.trim(),
  howToGetThere: {
    airport: "Jackson Hole (JAC)",
    notes: "The park is just minutes from the airport — no long drive needed.",
  },
  placesToStay: [
    { label: "We found an AirBNB in Jackson Hole, Wyoming.", url: "https://www.airbnb.com/s/Jackson-Hole--WY/" },
  ],
};

const galleryId = "grand-teton-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
