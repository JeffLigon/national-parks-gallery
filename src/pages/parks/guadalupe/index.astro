---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/guadalupe.json";

const park = {
  name: "Guadalupe Mountains National Park",
  location: "Texas",
  yearVisited: "2017 & 2022",
  hero: galleryData.hero,
  subtitle: "Ancient fossil reef rising from the Chihuahuan Desert.",
  description: `I went here on two different trips with the kids.  One was a Boy Scout trip with Brady in 2017 and the second was a spring break backpacking trip with Rachel in 2022.   This is such a unique geography in the middle of West Texas because up at the tops of the cliffs you're hiking through an Alpine forest because it's so high above the desert, such a cool place!`.trim(),
  howToGetThere: {
    airport: "El Paso (ELP)",
    notes: "Rent a car — it's about a 2 hour drive east on US-62.  Or it's a 9 hour drive from Dallas.",
  },
  placesToStay: [
    { label: "I actually drove from Dallas both times and stayed in Carlsbad, New Mexico.", url: "https://www.hotels.com/Hotel-Search?destination=Carlsbad%252C%20New%20Mexico%252C%20United%20States%20of%20America" },
  ],
};

const galleryId = "guadalupe-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
