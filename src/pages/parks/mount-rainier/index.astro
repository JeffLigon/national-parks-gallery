---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/mount-rainier.json";

const park = {
  name: "Mount Rainier National Park",
  location: "Washington",
  yearVisited: 2022,
  hero: galleryData.hero,
  subtitle: "A glaciated volcano rising above the Pacific Northwest.",
  description: `Add your description of Mount Rainier here.`.trim(),
  howToGetThere: {
    airport: "Seattle (SEA)",
    notes: "Rent a car — it's about a 2 hour drive southeast on SR-706.",
  },
  placesToStay: [
    { label: "Add your accommodation here", url: "#" },
  ],
};

const galleryId = "mount-rainier-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
