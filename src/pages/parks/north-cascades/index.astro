---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/north-cascades.json";

const park = {
  name: "North Cascades National Park",
  location: "Washington",
  yearVisited: 2023,
  hero: galleryData.hero,
  subtitle: "Remote peaks, glaciers, and wild river valleys.",
  description: `Add your description of North Cascades here.`.trim(),
  howToGetThere: {
    airport: "Seattle (SEA)",
    notes: "Rent a car — it's about a 3 hour drive east on SR-20.",
  },
  placesToStay: [
    { label: "Add your accommodation here", url: "#" },
  ],
};

const galleryId = "north-cascades-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
