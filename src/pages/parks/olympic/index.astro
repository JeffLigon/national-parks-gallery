---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/olympic.json";

const park = {
  name: "Olympic National Park",
  location: "Washington",
  yearVisited: 2021,
  hero: galleryData.hero,
  subtitle: "Rainforests, rugged coastline, and alpine peaks.",
  description: `Add your description of Olympic here.`.trim(),
  howToGetThere: {
    airport: "Seattle (SEA)",
    notes: "Rent a car — about a 2 hour drive including a ferry crossing.",
  },
  placesToStay: [
    { label: "Add your accommodation here", url: "#" },
  ],
};

const galleryId = "olympic-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
