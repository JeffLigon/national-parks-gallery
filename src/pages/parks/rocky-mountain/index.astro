---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/rocky-mountain.json";

const park = {
  name: "Rocky Mountain National Park",
  location: "Colorado",
  yearVisited: 2016,
  hero: galleryData.hero,
  subtitle: "Alpine meadows, tundra, and peaks above 14,000 feet.",
  description: ` Our first trip here was just a quick day trip.
  It was part 3 day weekend staying in Denver and we drove out to do a day hike.  
   It is nice that it's close to a major city so it makes it easy to access.
   BONUS TIP: We had drinks afterword at the Stanley Hotel,
   which is the hotel made famous by "The Shining".`.trim(),
  howToGetThere: {
    airport: "Denver (DEN)",
    notes: "Rent a car — it's about a 2 hour drive northwest.",
  },
  placesToStay: [
    { label: "We stayed near downtown Denver.", url: "https://www.airbnb.com/s/Denver--CO/" },
  ],
};

const galleryId = "rocky-mountain-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
