---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/smoky-mountains.json";

const park = {
  name: "Great Smoky Mountains National Park",
  location: "Tennessee",
  yearVisited: 2019,
  hero: galleryData.hero,
  subtitle: "Ancient mountains wrapped in mist and wildflowers.",
  description: `In 2019, Candace and I visited our friends Eddie and Sarah, who were living in Knoxville, TN at the time. It was a great opportunity to visit a new national park just a short drive away—Great Smoky Mountains National Park. We only did one hike there, but it was a very beautiful hike along a river in the fall.`.trim(),
  howToGetThere: {
    airport: "Knoxville (TYS)",
    notes: "The park was a short drive from Knoxville, where we were visiting friends.",
  },
  placesToStay: [
    { label: "We stayed with our friends Eddie and Sarah in Knoxville, TN." },
  ],
};

const galleryId = "smoky-mountains-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
