---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/virgin-islands.json";

const park = {
  name: "Virgin Islands National Park",
  location: "U.S. Virgin Islands",
  yearVisited: 2021,
  hero: galleryData.hero,
  subtitle: "Turquoise bays, coral reefs, and tropical hillsides.",
  description: `Add your description of Virgin Islands here.`.trim(),
  howToGetThere: {
    airport: "St. Thomas (STT)",
    notes: "Take a ferry from Red Hook to Cruz Bay on St. John — about 20 minutes.",
  },
  placesToStay: [
    { label: "Add your accommodation here", url: "#" },
  ],
};

const galleryId = "virgin-islands-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
