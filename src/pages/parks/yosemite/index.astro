---
import ParkLayout from "../../../layouts/ParkLayout.astro";
import galleryData from "../../../data/photos/yosemite.json";

const park = {
  name: "Yosemite National Park",
  location: "California",
  yearVisited: 2017,
  hero: galleryData.hero,
  subtitle: "Granite cliffs, waterfalls, and high-country light.",
  description: `
Yosemite is probably my favorite national park. When you first drive in the major
road and you see the landscape the words "awe-inspiring" comes to mind, and I think this
is the type of place where the word was invented. Everywhere you look, there
 is some magnificent stone face or a giant waterfall or a beautiful valley or a
 beautiful mountain stream.  Everywhere you look is a feast for the eyes.
`.trim(),
  howToGetThere: {
    airport: "San Francisco (SFO)",
    notes: "Rent a car at the airport — it's about a 3 hour drive to the valley.",
  },
  placesToStay: [
    { label: "We stayed in an Airbnb in Groveland, CA", url: "https://www.airbnb.com/s/Yosemite-National-Park--CA/" },
  ],
};

const galleryId = "yosemite-gallery";
---

<ParkLayout park={park} galleryData={galleryData} galleryId={galleryId} />
